@page "/request/"
@page "/request/{Id:int}"
@inherits RequestBase

<PageTitle>FeatureTracker - Request</PageTitle>

<div class="d-flex flex-column gap-6 px-2">
    <MudGrid>
        <MudItem xs=12 sm=12 md=12 lg=12 xl=12 xxl=12 Class="d-flex justify-start">
            <MudButton StartIcon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" IconSize="Size.Small" Variant="Variant.Text" OnClick="() => BackToRequests()">Back to requests</MudButton>
        </MudItem>
    </MudGrid>

    <MudGrid Class="align-center">
        <MudItem xs=12 sm=12 md=7 lg=7 xl=7 xxl=7>
            <MudText Typo="Typo.h3">Submit New Feature Request</MudText>
            <MudText Typo="Typo.body1">Tell us about the improvement you'd like to see in our product.</MudText>
        </MudItem>
        <MudItem xs=12 sm=12 md=5 lg=5 xl=5 xxl=5 Class="d-flex justify-end">
            🌟 Share your brilliant ideas!
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs=12 sm=12 md=12 lg=12 xl=12 xxl=12>
            <MudCard>
                <MudCardHeader Class="pa-6 mud-theme-primary">
                    <MudGrid>
                        <MudItem xs=12 sm=12 md=12 lg=12 xl=12 xxl=12 Class="d-flex flex-column">
                            <MudText Typo="Typo.h6">
                                💡 New Feature Request
                            </MudText>
                            <MudText Typo="Typo.body2" Style="color: #a1a1aa;">
                                Fill out the form below to submit your feature request. Our team will review it and provide feedback.
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudCardHeader>
                <MudCardContent>
                    <div class="ma-4">
                        <MudGrid>
                            <MudItem xs=12 sm=12 md=12 lg=12 xl=12 xxl=12>
                                <MudTextField T="string" Variant="Variant.Outlined" Label="Feature Title" Placeholder="@TitlePlaceholder" HelperText="This field is generate automatically by your description!" Disabled="TitleDisabled" Required></MudTextField>
                            </MudItem>
                            <MudItem xs=12 sm=12 md=12 lg=12 xl=12 xxl=12>
                                <MudTextField T="string"
                                              AutoFocus
                                              Required
                                              Variant="Variant.Outlined"
                                              Label="Description"
                                              Lines="10"
                                              HelperText="The more details you provide, the better we can understand your needs."
                                              Placeholder="Describe the feature in detail. What problem does it solve? How would it work?"></MudTextField>
                            </MudItem>
                            <MudItem xs=12 sm=12 md=6 lg=6 xl=6 xxl=6>
                                <MudSelect T="string" Label="Category" HelperText="Select the category that best fits your request." Variant="Variant.Outlined" Margin="Margin.Dense" Dense>
                                    <MudSelectItem T="string">
                                        Select Category
                                    </MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs=12 sm=12 md=6 lg=6 xl=6 xxl=6>
                                <MudSelect T="string" Label="Priority" HelperText="How important is this feature to you?" Variant="Variant.Outlined" Margin="Margin.Dense" Dense>
                                    <MudSelectItem T="string">
                                        🟢 Low
                                    </MudSelectItem>
                                    <MudSelectItem T="string">
                                        🟠 Medium
                                    </MudSelectItem>
                                    <MudSelectItem T="string">
                                        🔴 High
                                    </MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs=12 sm=12 md=12 lg=12 xl=12 xxl=12>
                                <MudCard Elevation="0" Class="p-0">
                                    <MudCardContent Class="p-0">
                                        <FileUploadComponent />
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs=12 sm=12 md=12 lg=12 xl=12 xxl=12>
                                <MudCard Elevation="0" Style="border: 1px solid #666;">
                                    <MudCardContent>
                                        <MudCheckBox T="bool">
                                            <MudText Typo="Typo.body2" Style="font-weight: bold;">
                                                I understand that submitting a feature request does not guarantee implementation.
                                            </MudText>
                                            <MudText Typo="Typo.caption" Style="color: #a1a1aa;">
                                                All requests are reviewed by our team, and we will provide feedback on the feasibility and potential timeline for implementation.
                                            </MudText>
                                        </MudCheckBox>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Large" Class="px-4 py-2">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="px-4 py-2">Submit Request</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</div>
